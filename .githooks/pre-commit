#!/usr/bin/env bash

set -euo pipefail

branch_name="$(git symbolic-ref --quiet --short HEAD 2>/dev/null || true)"

case "$branch_name" in
  main | master)
    printf 'Commit blocked: %s is protected. Start a feature branch first.\n' "$branch_name" >&2
    printf 'Run: scripts/start-change <branch-slug>\n' >&2
    exit 1
    ;;
esac
